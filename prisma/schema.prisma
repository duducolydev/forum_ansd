// Schéma de données — Portail Forum international sur les données (ANSD)
// Référence : docs/BRIEF_Claude_Code_Portail_Forum_ANSD.md §4
//
// Convention editionId (cf. brief : « Toutes les tables métier portent editionId ») :
// appliquée à toute entité métier propre à une édition du Forum. Exceptions volontaires,
// car ce sont des tables d'infrastructure transverses aux éditions, pas des données
// « métier » d'une édition donnée :
//   - User / Role                 : le BackOffice est partagé entre éditions (D1).
//   - AuditLog / Job / Setting    : journalisation et infrastructure technique.
// Les tables de jonction/log qui référencent déjà une entité edition-scopée
// (CategoryZone, ParticipantZoneOverride, ScanLog, SessionSpeaker, SessionRegistration,
// Contribution, Badge, MagicLink, NotificationLog) n'ont pas de editionId dupliqué :
// il est transitif via leur relation obligatoire.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum ParticipantStatus {
  INVITED
  INVITATION_SENT
  REGISTRATION_STARTED
  REGISTERED
  CONFIRMED
  BADGED
  CHECKED_IN
  DECLINED
  CANCELLED
}

enum ParticipantSource {
  ONLINE
  ONSITE
  IMPORT
}

enum InvitationStatus {
  PENDING
  SENT
  OPENED
  CLICKED
  REGISTERED
  DECLINED
  EXPIRED
}

enum SpeakerConfirmationStatus {
  PRESSENTI
  CONTACTE
  INVITE
  ACCEPTE
  CONFIRME
  PRESENT
}

enum SessionSpeakerRole {
  MODERATOR
  PANELIST
  KEYNOTE
  GUEST_OF_HONOR
}

enum SessionRegistrationStatus {
  REGISTERED
  WAITLISTED
  CANCELLED
  ATTENDED
}

enum SessionType {
  OPENING
  PLENARY
  PANEL
  INAUGURAL
  AWARDS
  BREAK
  LUNCH
  CLOSING
  SIDE_EVENT
}

enum ScanDirection {
  IN
  OUT
}

enum ScanResult {
  OK
  ALREADY
  DENIED_ZONE
  DENIED_STATUS
  REVOKED
  UNKNOWN
}

enum ContributionType {
  PROBLEM
  OBJECTIVES
  KEY_QUESTIONS
  PRESENTATION
  DOCUMENT
  PHOTO
  VIDEO
  SYNTHESIS
  RECOMMENDATION
  CONCLUSION
}

/// D'où vient une contribution. C'est ce qui décide qui peut la publier : une
/// présentation déposée par un intervenant ne se publie qu'avec son accord.
enum ContributionOrigine {
  COMITE
  INTERVENANT
  RAPPORTEUR
}

enum DocumentCategory {
  TDR
  PROGRAM
  PRESS
  RELEASE
  PROCEEDINGS
  OTHER
}

enum NotificationChannel {
  EMAIL
  SMS
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  BOUNCED
}

enum AuditActorType {
  USER
  PARTICIPANT
  SYSTEM
}

enum JobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

// ---------------------------------------------------------------------------
// Édition & BackOffice
// ---------------------------------------------------------------------------

model Edition {
  id        String   @id @default(cuid())
  code      String   @unique // ex. FID-2026
  title     String
  theme     String?
  startDate DateTime
  endDate   DateTime
  venue     String
  city      String
  isActive  Boolean  @default(false)
  settings  Json // validation auto par catégorie, ouverture inscriptions, etc.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categories            ParticipantCategory[]
  participants          Participant[]
  invitations           Invitation[]
  delegations           Delegation[]
  referents             Referent[]
  hotels                Hotel[]
  practicalContacts     PracticalContact[]
  zones                 Zone[]
  checkpoints           Checkpoint[]
  rooms                 Room[]
  sessions              Session[]
  speakers              Speaker[]
  sponsorLevels         SponsorLevel[]
  sponsors              Sponsor[]
  documents             Document[]
  posts                 Post[]
  newsletters           Newsletter[]
  contentBlocks         ContentBlock[]
  pageSections          PageSection[]
  notificationTemplates NotificationTemplate[]
  contributions         Contribution[]
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  passwordHash   String
  name           String
  roleId         String
  /// Ancien second facteur par application d'authentification, remplacé par la
  /// validation par e-mail (PLAN.md §23). Colonnes conservées le temps de valider
  /// le nouveau facteur en production ; plus lues par le code.
  totpSecret     String?
  totpEnabled    Boolean   @default(false)
  isActive       Boolean   @default(true)
  lastLoginAt    DateTime?
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  /// Incrémenté pour fermer toutes les sessions ouvertes du compte (mot de
  /// passe ou 2FA réinitialisés, désactivation) — PLAN.md §18.
  sessionVersion Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  role Role @relation(fields: [roleId], references: [id])

  confirmedParticipants Participant[]             @relation("ParticipantConfirmedBy")
  generatedBadges       Badge[]                   @relation("BadgeGeneratedBy")
  grantedZoneOverrides  ParticipantZoneOverride[] @relation("ZoneOverrideGrantedBy")
  scans                 ScanLog[]                 @relation("ScanAgent")
  updatedContentBlocks  ContentBlock[]            @relation("ContentBlockUpdatedBy")
  auditLogs             AuditLog[]                @relation("AuditActorUser")
  sessionsRapportees    SessionRapporteur[]
  defisConnexion        AdminLoginChallenge[]

  @@index([roleId])
}

/// Second facteur des comptes BackOffice : code à 6 chiffres et lien de
/// validation envoyés par e-mail après un mot de passe correct (PLAN.md §23).
///
/// Une ligne par tentative : le code n'est jamais stocké côté session, le jeton
/// du lien l'est sous forme d'empreinte, et `failedAttempts` borne les essais.
model AdminLoginChallenge {
  id             String    @id @default(cuid())
  userId         String
  /// SHA-256 du jeton du lien : une fuite de la base ne donne pas de lien valide.
  tokenHash      String    @unique
  code6          String
  expiresAt      DateTime
  usedAt         DateTime?
  failedAttempts Int       @default(0)
  ip             String?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Role {
  id          String   @id @default(cuid())
  /// Identifiant technique, en capitales : c'est lui que le code compare
  /// (`exigeSecondFacteur`, `ROLE_LABELS`, le seed). Il ne change plus une fois
  /// le rôle créé — un rôle intégré ne se renomme pas, cf. `modules/users`.
  name        String   @unique
  /// Libellé lisible, affiché partout où un humain lit un rôle.
  ///
  /// Vide pour les rôles du brief : le leur vient de `ROLE_LABELS`, et le
  /// dupliquer en base aurait créé deux vérités qui divergent. Il n'est
  /// renseigné que pour les rôles créés depuis le BackOffice, qui n'ont aucune
  /// entrée dans ce registre.
  label       String?
  permissions Json // string[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]
}

// ---------------------------------------------------------------------------
// Participants
// ---------------------------------------------------------------------------

model ParticipantCategory {
  id                String   @id @default(cuid())
  editionId         String
  code              String
  labelFr           String
  labelEn           String
  color             String?
  badgeTemplateId   String?
  autoConfirm       Boolean  @default(false)
  requiresLogistics Boolean  @default(false)
  alertOnScan       Boolean  @default(false) // scan orange : catégorie à accueillir (§2.5)
  sortOrder         Int      @default(0)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  edition       Edition        @relation(fields: [editionId], references: [id], onDelete: Cascade)
  participants  Participant[]
  invitations   Invitation[]
  categoryZones CategoryZone[]

  @@unique([editionId, code])
}

model Participant {
  id                  String            @id @default(cuid())
  editionId           String
  publicId            String            @unique // ex. FID26-7K3M2P, non séquentiel
  civility            String?
  firstName           String
  lastName            String
  email               String
  phone               String?
  photoPath           String?
  locale              String            @default("fr")
  jobTitle            String?
  organization        String?
  organizationType    String?
  activityDomain      String?
  bio                 String?           @db.Text
  website             String?
  country             String
  city                String?
  categoryId          String
  delegationId        String?
  invitationId        String?           @unique
  status              ParticipantStatus @default(INVITED)
  participationDays   Json?
  attendsOpening      Boolean           @default(false)
  attendsInaugural    Boolean           @default(false)
  attendsAwards       Boolean           @default(false)
  arrivalDate         DateTime?
  departureDate       DateTime?
  needsAccommodation  Boolean           @default(false)
  needsTransport      Boolean           @default(false)
  dietaryRequirements String?
  specialNeeds        String?
  consentTerms        Boolean           @default(false)
  consentData         Boolean           @default(false)
  consentImage        Boolean           @default(false)
  consentAt           DateTime?
  source              ParticipantSource @default(ONLINE)
  registeredAt        DateTime?
  confirmedAt         DateTime?
  confirmedById       String?
  notes               String?           @db.Text
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  deletedAt           DateTime?

  edition     Edition             @relation(fields: [editionId], references: [id], onDelete: Cascade)
  category    ParticipantCategory @relation(fields: [categoryId], references: [id])
  delegation  Delegation?         @relation("DelegationMembers", fields: [delegationId], references: [id])
  headOf      Delegation?         @relation("DelegationHead")
  invitation  Invitation?         @relation(fields: [invitationId], references: [id])
  confirmedBy User?               @relation("ParticipantConfirmedBy", fields: [confirmedById], references: [id])
  speaker     Speaker?

  badges               Badge[]
  sessionRegistrations SessionRegistration[]
  scanLogs             ScanLog[]
  zoneOverrides        ParticipantZoneOverride[]
  magicLinks           MagicLink[]
  notificationLogs     NotificationLog[]
  auditLogs            AuditLog[]                @relation("AuditActorParticipant")

  @@unique([editionId, email])
  @@index([editionId, status])
  @@index([editionId, categoryId])
}

model Invitation {
  id             String           @id @default(cuid())
  editionId      String
  email          String
  firstName      String
  lastName       String
  organization   String?
  // Ajouté au-delà des champs listés au brief §4 : nécessaire pour filtrer les
  // relances par pays (brief §5.5 « Relances ... filtrées catégorie/pays »),
  // qu'aucun autre champ du modèle ne permet de dériver avant inscription.
  country        String?
  categoryId     String
  token          String           @unique
  status         InvitationStatus @default(PENDING)
  sentAt         DateTime?
  remindersCount Int              @default(0)
  lastReminderAt DateTime?
  openedAt       DateTime?
  respondedAt    DateTime?
  importBatchId  String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  edition     Edition             @relation(fields: [editionId], references: [id], onDelete: Cascade)
  category    ParticipantCategory @relation(fields: [categoryId], references: [id])
  participant Participant?

  @@index([editionId, status])
}

model Delegation {
  id                String   @id @default(cuid())
  editionId         String
  name              String
  country           String?
  institution       String?
  headParticipantId String?  @unique
  /// Référent interne qui guide cette délégation. Facultatif : une délégation
  /// existe avant qu'on lui en désigne un.
  referentId        String?
  maxMembers        Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  edition         Edition       @relation(fields: [editionId], references: [id], onDelete: Cascade)
  headParticipant Participant?  @relation("DelegationHead", fields: [headParticipantId], references: [id])
  referent        Referent?     @relation(fields: [referentId], references: [id], onDelete: SetNull)
  members         Participant[] @relation("DelegationMembers")

  @@index([referentId])
}

/// Référent interne : le membre du comité d'organisation qui guide une
/// délégation, et dont les coordonnées sont communiquées à ses participants.
///
/// Table dédiée plutôt que trois colonnes sur `Delegation` : un même référent
/// suit souvent plusieurs délégations, et corriger un numéro de téléphone doit
/// le corriger partout d'un coup. C'est aussi ce qui permet de tenir un
/// annuaire, consultable avant même qu'une délégation existe.
///
/// Pas de lien vers `User` : un référent n'a pas de raison d'avoir un compte
/// BackOffice, et en exiger un aurait fait créer des comptes qui ne servent
/// qu'à porter un nom — des comptes qui restent ouverts après le Forum.
model Referent {
  id        String   @id @default(cuid())
  editionId String
  name      String
  email     String
  phone     String?
  /// Fonction au sein du comité, affichée aux participants : « Protocole »,
  /// « Logistique »… Facultative, et libre : les intitulés changent d'une
  /// édition à l'autre.
  role      String?
  /// Un référent qui quitte le comité est désactivé, jamais supprimé : les
  /// délégations qu'il a suivies gardent la trace de qui les accompagnait.
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  edition     Edition      @relation(fields: [editionId], references: [id], onDelete: Cascade)
  delegations Delegation[]

  /// Une adresse par édition : c'est elle qui identifie une personne, et deux
  /// fiches pour la même adresse feraient partir deux fois chaque alerte.
  @@unique([editionId, email])
  @@index([editionId])
}

// ---------------------------------------------------------------------------
// Badges & QR
// ---------------------------------------------------------------------------

model Badge {
  id            String    @id @default(cuid())
  participantId String
  version       Int       @default(1)
  qrToken       String    @unique // hash du token QR
  generatedAt   DateTime?
  generatedById String?
  pdfPath       String?
  pngPath       String?
  downloadedAt  DateTime?
  emailedAt     DateTime?
  printedAt     DateTime?
  printedCount  Int       @default(0)
  revokedAt     DateTime?
  revokeReason  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  generatedBy User?       @relation("BadgeGeneratedBy", fields: [generatedById], references: [id])
  scanLogs    ScanLog[]

  @@index([participantId])
}

// ---------------------------------------------------------------------------
// Zones & contrôle d'accès
// ---------------------------------------------------------------------------

model Zone {
  id          String  @id @default(cuid())
  editionId   String
  code        String
  name        String
  description String? @db.Text

  edition       Edition                   @relation(fields: [editionId], references: [id], onDelete: Cascade)
  categoryZones CategoryZone[]
  checkpoints   Checkpoint[]
  overrides     ParticipantZoneOverride[]

  @@unique([editionId, code])
}

model CategoryZone {
  id         String @id @default(cuid())
  categoryId String
  zoneId     String

  category ParticipantCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  zone     Zone                @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@unique([categoryId, zoneId])
}

model ParticipantZoneOverride {
  id            String   @id @default(cuid())
  participantId String
  zoneId        String
  grantedById   String?
  reason        String?  @db.Text
  createdAt     DateTime @default(now())

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  zone        Zone        @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  grantedBy   User?       @relation("ZoneOverrideGrantedBy", fields: [grantedById], references: [id])

  @@unique([participantId, zoneId])
}

model Checkpoint {
  id          String  @id @default(cuid())
  editionId   String
  name        String
  zoneId      String
  deviceLabel String?
  isActive    Boolean @default(true)

  edition  Edition   @relation(fields: [editionId], references: [id], onDelete: Cascade)
  zone     Zone      @relation(fields: [zoneId], references: [id])
  scanLogs ScanLog[]
}

model ScanLog {
  id            String        @id @default(cuid())
  participantId String?
  badgeVersion  Int
  checkpointId  String
  agentUserId   String?
  scannedAt     DateTime      @default(now())
  day           DateTime      @db.Date
  direction     ScanDirection @default(IN)
  result        ScanResult
  clientScanId  String        @unique // UUID côté client, idempotence hors-ligne
  syncedAt      DateTime?
  badgeId       String?

  participant Participant? @relation(fields: [participantId], references: [id])
  checkpoint  Checkpoint   @relation(fields: [checkpointId], references: [id], onDelete: Cascade)
  agent       User?        @relation("ScanAgent", fields: [agentUserId], references: [id])
  badge       Badge?       @relation(fields: [badgeId], references: [id])

  @@index([day, checkpointId])
  @@index([participantId, day])
}

// ---------------------------------------------------------------------------
// Programme
// ---------------------------------------------------------------------------

model Room {
  id        String  @id @default(cuid())
  editionId String
  name      String
  capacity  Int?
  floor     String?

  edition  Edition   @relation(fields: [editionId], references: [id], onDelete: Cascade)
  sessions Session[]
}

model Session {
  id                   String      @id @default(cuid())
  editionId            String
  slug                 String
  number               Int?
  type                 SessionType
  titleFr              String
  titleEn              String
  descriptionFr        String?     @db.Text
  descriptionEn        String?     @db.Text
  objectives           String?     @db.Text
  theme                String?
  day                  DateTime    @db.Date
  startTime            DateTime
  endTime              DateTime
  roomId               String?
  capacity             Int?
  registrationOpen     Boolean     @default(false)
  registrationDeadline DateTime?
  waitlistEnabled      Boolean     @default(true)
  vipQuota             Int?
  tdrPath              String?
  isPublished          Boolean     @default(false)
  liveStreamUrl        String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  deletedAt            DateTime?

  edition       Edition               @relation(fields: [editionId], references: [id], onDelete: Cascade)
  room          Room?                 @relation(fields: [roomId], references: [id])
  speakers      SessionSpeaker[]
  registrations SessionRegistration[]
  contributions Contribution[]
  rapporteurs   SessionRapporteur[]

  @@unique([editionId, slug])
}

model Speaker {
  id                       String    @id @default(cuid())
  editionId                String
  participantId            String?   @unique
  /// Adresse propre à l'intervenant, pour son espace de dépôt.
  ///
  /// Nullable et distincte de celle du participant : un panéliste n'est pas
  /// forcément inscrit au Forum (`participantId` est facultatif), et sans
  /// adresse ici il serait injoignable — c'est le manque réel derriere C12.
  /// L'adresse retenue pour l'envoi est celle-ci, sinon celle du participant lié.
  email                    String?
  firstName                String
  lastName                 String
  jobTitle                 String?
  organization             String?
  country                  String?
  photoPath                String?
  bioFr                    String?   @db.Text
  bioEn                    String?   @db.Text
  presentationPath         String?
  /// Accord de l'intervenant pour que sa présentation soit publiée sur le site.
  /// Sans lui, le comité ne peut pas publier la contribution qui en est issue.
  presentationConsentement Boolean   @default(false)
  isPublished              Boolean   @default(false)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  deletedAt                DateTime?

  edition       Edition          @relation(fields: [editionId], references: [id], onDelete: Cascade)
  participant   Participant?     @relation(fields: [participantId], references: [id])
  sessions      SessionSpeaker[]
  contributions Contribution[]
  magicLinks    MagicLink[]
}

model SessionSpeaker {
  id                 String                    @id @default(cuid())
  sessionId          String
  speakerId          String
  role               SessionSpeakerRole
  confirmationStatus SpeakerConfirmationStatus @default(PRESSENTI)
  sortOrder          Int                       @default(0)

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  speaker Speaker @relation(fields: [speakerId], references: [id], onDelete: Cascade)

  @@unique([sessionId, speakerId])
}

model SessionRegistration {
  id               String                    @id @default(cuid())
  sessionId        String
  participantId    String
  status           SessionRegistrationStatus @default(REGISTERED)
  waitlistPosition Int?
  registeredAt     DateTime                  @default(now())
  promotedAt       DateTime?
  cancelledAt      DateTime?

  session     Session     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([sessionId, participantId])
  @@index([sessionId, status])
}

// ---------------------------------------------------------------------------
// Sponsors
// ---------------------------------------------------------------------------

model SponsorLevel {
  id           String @id @default(cuid())
  editionId    String
  code         String
  name         String
  sortOrder    Int    @default(0)
  logoMaxWidth Int?

  edition  Edition   @relation(fields: [editionId], references: [id], onDelete: Cascade)
  sponsors Sponsor[]

  @@unique([editionId, code])
}

model Sponsor {
  id            String    @id @default(cuid())
  editionId     String
  name          String
  levelId       String
  logoPath      String?
  descriptionFr String?   @db.Text
  descriptionEn String?   @db.Text
  website       String?
  videoUrl      String?
  standNumber   String?
  contactName   String?
  contactEmail  String?
  /// Rang d'affichage sur la page publique, tous niveaux confondus (§32).
  ///
  /// Le site groupait les partenaires par niveau, ce qui imposait l'ordre du
  /// barème : un partenaire institutionnel décisif passait après trois
  /// sponsors d'un échelon supérieur. Le comité décide désormais lui-même de
  /// la succession, et le niveau redevient ce qu'il est — une mention sur la
  /// carte, pas un plan de page.
  sortOrder     Int       @default(0)
  isPublished   Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  edition Edition      @relation(fields: [editionId], references: [id], onDelete: Cascade)
  level   SponsorLevel @relation(fields: [levelId], references: [id])

  @@index([editionId, sortOrder])
}

// ---------------------------------------------------------------------------
// Contributions & Actes / documentation / contenus
// ---------------------------------------------------------------------------

model Contribution {
  id          String              @id @default(cuid())
  editionId   String
  sessionId   String
  type        ContributionType
  title       String
  body        String?             @db.Text
  filePath    String?
  url         String?
  speakerId   String?
  isPublished Boolean             @default(false)
  origine     ContributionOrigine @default(COMITE)
  sortOrder   Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  edition Edition  @relation(fields: [editionId], references: [id], onDelete: Cascade)
  session Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  speaker Speaker? @relation(fields: [speakerId], references: [id])
}

/// Rapporteur rattaché à une session (§15). Il rédige des contributions sur ses
/// sessions et sur elles seules ; la publication reste au gestionnaire programme.
model SessionRapporteur {
  id        String   @id @default(cuid())
  sessionId String
  userId    String
  createdAt DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Infos pratiques : hébergement et contacts (§29)
// ---------------------------------------------------------------------------

/// Hôtel partenaire, présenté sur la page « Infos pratiques » et sa page de
/// détail.
///
/// Données structurées et non texte libre : un participant compare des prix,
/// des distances et des prestations, et cherche celui qui a une navette. Un
/// paragraphe rédigé aurait servi la rédaction, pas la comparaison — qui est
/// exactement ce que le visiteur vient faire.
model Hotel {
  id            String    @id @default(cuid())
  editionId     String
  name          String
  /// Catégorie affichée telle quelle : « 5 étoiles », « Résidence »… Libre,
  /// parce que les classements varient d'un pays à l'autre.
  category      String?
  address       String?
  district      String?
  /// Distance du lieu du Forum, en kilomètres. Le critère de choix numéro un
  /// pour trois jours de navettes matin et soir.
  distanceKm    Decimal?  @db.Decimal(5, 2)
  phone         String?
  email         String?
  website       String?
  /// Lien vers une carte. Stocké plutôt que composé : les adresses de Dakar
  /// sont mal géocodées, et un lien vérifié vaut mieux qu'une recherche.
  mapUrl        String?
  descriptionFr String?   @db.Text
  descriptionEn String?   @db.Text
  /// Prestations, en `string[]` : navette, wifi, petit-déjeuner, piscine…
  /// Un tableau plutôt qu'une table dédiée — ce sont des étiquettes, sans
  /// attribut propre, et elles changent d'une édition à l'autre.
  amenities     Json
  /// Code de réservation négocié par le comité, envoyé après confirmation.
  bookingCode   String?
  bookingUrl    String?
  photoPath     String?
  /// Un hôtel se prépare avant d'être montré : tarifs à saisir, accord à
  /// obtenir. Rien n'est public tant que cette case n'est pas cochée.
  isPublished   Boolean   @default(false)
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  edition Edition     @relation(fields: [editionId], references: [id], onDelete: Cascade)
  rates   HotelRate[]

  @@index([editionId])
}

/// Tarif d'un hôtel, par type de chambre.
///
/// Table séparée parce qu'un hôtel en propose plusieurs, et que le participant
/// choisit entre eux. Les aplatir en colonnes aurait plafonné leur nombre et
/// rendu la comparaison impossible.
model HotelRate {
  id         String   @id @default(cuid())
  hotelId    String
  /// « Chambre simple », « Chambre double », « Suite »…
  roomType   String
  /// En unité entière de la devise : les tarifs hôteliers de Dakar sont en
  /// francs CFA, sans centimes, et un flottant sur un prix invite l'erreur
  /// d'arrondi.
  price      Int?
  currency   String   @default("XOF")
  /// Ce que le tarif comprend, ou ses restrictions : petit-déjeuner inclus,
  /// minimum deux nuits…
  conditions String?  @db.Text
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId])
}

/// Contact du comité publié sur la page « Infos pratiques ».
///
/// Structuré plutôt que noyé dans un paragraphe : un participant cherche « qui
/// appelle-t-on pour les visas », et une liste répond quand un texte suivi
/// oblige à le relire en entier.
model PracticalContact {
  id        String   @id @default(cuid())
  editionId String
  /// Objet du contact : « Accréditation presse », « Logistique »…
  labelFr   String
  labelEn   String?
  name      String?
  email     String?
  phone     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  edition Edition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@index([editionId])
}

model Document {
  id        String           @id @default(cuid())
  editionId String
  title     String
  category  DocumentCategory
  filePath  String
  isPublic  Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  edition Edition @relation(fields: [editionId], references: [id], onDelete: Cascade)
}

/// Newsletter : une information publiée sur le site et envoyée aux participants
/// (§34).
///
/// Table à part des actualités, bien que les deux se ressemblent : une
/// actualité se publie, une newsletter **s'envoie**. Elle porte donc un cycle
/// que l'actualité n'a pas — brouillon, publiée, envoyée — et l'envoi est
/// irréversible : mille messages partis ne se rappellent pas. Les mélanger
/// aurait fait cohabiter deux objets dont l'un a un bouton sans retour.
model Newsletter {
  id        String  @id @default(cuid())
  editionId String
  slug      String
  titleFr   String
  titleEn   String
  /// Chapô : repris dans l'e-mail d'annonce et dans la liste. Distinct du
  /// corps, parce qu'un e-mail ne reprend pas le texte intégral (§34).
  excerptFr String  @db.Text
  excerptEn String  @db.Text
  /// Corps mis en forme, document structuré sérialisé (`lib/texte-riche.ts`).
  /// Jamais du HTML : voir l'en-tête de ce module pour la raison.
  bodyFr    String  @db.Text
  bodyEn    String  @db.Text
  coverPath String?
  /// Images du corps : `[{ path }]`. Le document ne référence que leur **rang**
  /// dans cette liste, jamais un chemin — un chemin accepté depuis l'extérieur
  /// se transforme vite en lecture arbitraire du volume de stockage.
  images    Json?

  isPublished Boolean   @default(false)
  publishedAt DateTime?
  /// Date du premier envoi. Non nulle, la newsletter a été expédiée : le bouton
  /// disparaît, et une modification ultérieure ne rattrape pas les messages
  /// déjà partis.
  sentAt      DateTime?
  /// Nombre de destinataires au moment de l'envoi, pour le journal.
  sentCount   Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  edition Edition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@unique([editionId, slug])
  @@index([editionId, publishedAt])
}

model Post {
  id          String    @id @default(cuid())
  editionId   String
  slug        String
  titleFr     String
  titleEn     String
  /// Chapô : le résumé affiché en liste et dans les partages, distinct du corps.
  excerptFr   String?   @db.Text
  excerptEn   String?   @db.Text
  bodyFr      String    @db.Text
  bodyEn      String    @db.Text
  coverPath   String?
  /// Galerie : [{ path, captionFr, captionEn }]. En JSON plutôt qu'en table —
  /// une image de galerie n'existe que par son article et ne se requête jamais seule.
  gallery     Json?
  publishedAt DateTime?
  isPublished Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  edition Edition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@unique([editionId, slug])
}

/// Section de page paramétrable (PLAN.md §8.4).
///
/// Le `type` désigne une entrée d'un **catalogue fermé** côté code, et
/// `variant` l'une de ses présentations vérifiées. Rien ici ne décrit une mise
/// en page : ni coordonnées, ni styles libres. C'est l'arbitrage C15 — un
/// catalogue se teste et reste accessible, un moteur de mise en page non.
model PageSection {
  id        String   @id @default(cuid())
  editionId String
  /// Page d'accueil ou autre page composable : "accueil", "a-propos", …
  page      String
  type      String
  variant   String
  sortOrder Int      @default(0)
  isVisible Boolean  @default(true)
  /// Réglages propres au type (nombre d'éléments, source, alignement…).
  settings  Json
  /// Contenu rédactionnel, une version par langue.
  contentFr Json
  contentEn Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  edition Edition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@index([editionId, page, sortOrder])
}

model ContentBlock {
  id          String   @id @default(cuid())
  editionId   String
  key         String // home.hero, home.objectives, practical.visa, ...
  valueFr     Json
  valueEn     Json
  updatedById String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  edition   Edition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  updatedBy User?   @relation("ContentBlockUpdatedBy", fields: [updatedById], references: [id])

  @@unique([editionId, key])
}

// ---------------------------------------------------------------------------
// Notifications & lien magique
// ---------------------------------------------------------------------------

model NotificationTemplate {
  id        String              @id @default(cuid())
  editionId String
  key       String
  channel   NotificationChannel
  subjectFr String?
  subjectEn String?
  bodyFr    String              @db.Text
  bodyEn    String              @db.Text
  variables Json? // liste des variables disponibles, ex. ["prenom", "lien_badge"]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  edition Edition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@unique([editionId, key, channel])
}

model NotificationLog {
  id                String              @id @default(cuid())
  participantId     String
  templateKey       String
  channel           NotificationChannel
  to                String
  status            NotificationStatus  @default(QUEUED)
  providerMessageId String?
  error             String?             @db.Text
  sentAt            DateTime?
  createdAt         DateTime            @default(now())

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([participantId])
}

/// Lien à usage unique, pour un participant **ou** un intervenant.
///
/// Les deux destinataires partagent la même table, donc la même durée de vie,
/// le même hachage et les mêmes limites de débit : deux mecanismes parallèles
/// auraient fini par diverger, et c'est le plus négligé des deux qui aurait
/// porté la faille. Exactement un des deux liens est renseigné — la règle est
/// tenue par le code (`modules/auth/magic-link.ts`), MySQL 8 ne permettant pas
/// de contrainte CHECK portant sur deux colonnes nullables de façon lisible.
model MagicLink {
  id             String    @id @default(cuid())
  participantId  String?
  speakerId      String?
  tokenHash      String    @unique
  code6          String
  expiresAt      DateTime
  usedAt         DateTime?
  /// Codes à 6 chiffres erronés saisis pour ce lien ; au 5e, il est annulé
  /// (PLAN.md §18).
  failedAttempts Int       @default(0)
  createdAt      DateTime  @default(now())

  participant Participant? @relation(fields: [participantId], references: [id], onDelete: Cascade)
  speaker     Speaker?     @relation(fields: [speakerId], references: [id], onDelete: Cascade)

  @@index([participantId])
  @@index([speakerId])
}

// ---------------------------------------------------------------------------
// Audit, files/jobs, réglages
// ---------------------------------------------------------------------------

model AuditLog {
  id                 String         @id @default(cuid())
  actorType          AuditActorType
  actorUserId        String?
  actorParticipantId String?
  action             String
  entity             String
  entityId           String
  before             Json?
  after              Json?
  ip                 String?
  userAgent          String?
  createdAt          DateTime       @default(now())

  actorUser        User?        @relation("AuditActorUser", fields: [actorUserId], references: [id])
  actorParticipant Participant? @relation("AuditActorParticipant", fields: [actorParticipantId], references: [id])

  @@index([entity, entityId])
  @@index([createdAt])
}

model Job {
  id             String    @id @default(cuid())
  type           String
  payload        Json
  status         JobStatus @default(PENDING)
  attempts       Int       @default(0)
  runAt          DateTime  @default(now())
  error          String?   @db.Text
  // Ajouté au-delà des champs listés au brief §4 : nécessaire pour l'idempotence
  // des jobs exigée au §3.3 (envois d'email, génération de badges) côté DbJobQueue
  // (repli sans Redis) — cf. src/lib/queue.
  idempotencyKey String?   @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, runAt])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}
